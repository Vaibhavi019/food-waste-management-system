<%- include('../partials/header') %>

    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1>User Management</h1>
            <p>View, block, delete, and verify users</p>
        </div>

        <!-- Filters -->
        <div class="filter-bar">
            <a href="/admin/users" class="btn btn-sm <%= !roleFilter ? 'btn-primary' : 'btn-secondary' %>">All</a>
            <a href="/admin/users?role=donor"
                class="btn btn-sm <%= roleFilter === 'donor' ? 'btn-primary' : 'btn-secondary' %>">Donors</a>
            <a href="/admin/users?role=receiver"
                class="btn btn-sm <%= roleFilter === 'receiver' ? 'btn-primary' : 'btn-secondary' %>">Receivers</a>
        </div>

        <% if (users.length===0) { %>
            <div class="empty-state">
                <p>No users found.</p>
            </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Organization</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user=> { %>
                                <tr class="<%= user.isBlocked ? 'row-blocked' : '' %>">
                                    <td>
                                        <strong>
                                            <%= user.name %>
                                        </strong>
                                        <% if (user.isVerified && user.role==='receiver' ) { %>
                                            <span class="verified-badge" title="Verified NGO">✅</span>
                                            <% } %>
                                    </td>
                                    <td>
                                        <%= user.username %>
                                    </td>
                                    <td>
                                        <%= user.email %>
                                    </td>
                                    <td>
                                        <%= user.phone %>
                                    </td>
                                    <td>
                                        <span class="badge badge-<%= user.role === 'donor' ? 'info' : 'success' %>">
                                            <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
                                        </span>
                                    </td>
                                    <td>
                                        <%= user.organization || '—' %>
                                    </td>
                                    <td>
                                        <% if (user.isBlocked) { %>
                                            <span class="badge badge-danger">Blocked</span>
                                            <% } else { %>
                                                <span class="badge badge-success">Active</span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <form action="/admin/block-user/<%= user._id %>" method="POST"
                                                style="display:inline;">
                                                <button type="submit"
                                                    class="btn btn-sm <%= user.isBlocked ? 'btn-success' : 'btn-warning' %>"
                                                    title="<%= user.isBlocked ? 'Unblock' : 'Block' %>">
                                                    <%= user.isBlocked ? '🔓 Unblock' : '🔒 Block' %>
                                                </button>
                                            </form>
                                            <form action="/admin/delete-user/<%= user._id %>" method="POST"
                                                style="display:inline;"
                                                onsubmit="return confirm('Are you sure you want to delete this user?')">
                                                <button type="submit" class="btn btn-sm btn-danger">🗑️ Delete</button>
                                            </form>
                                            <% if (user.role==='receiver' ) { %>
                                                <form action="/admin/verify-ngo/<%= user._id %>" method="POST"
                                                    style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-info"
                                                        title="<%= user.isVerified ? 'Remove verification' : 'Verify NGO' %>">
                                                        <%= user.isVerified ? '❌ Unverify' : '✅ Verify' %>
                                                    </button>
                                                </form>
                                                <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>

                    <div class="form-actions" style="margin-top: 1.5rem;">
                        <a href="/admin/dashboard" class="btn btn-secondary">← Back to Dashboard</a>
                    </div>
    </div>

    <%- include('../partials/footer') %>