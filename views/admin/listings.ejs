<%- include('../partials/header') %>

    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1>Food Listings Management</h1>
            <p>View and manage all food listings</p>
        </div>

        <!-- Filters -->
        <div class="filter-bar">
            <a href="/admin/listings" class="btn btn-sm <%= !statusFilter ? 'btn-primary' : 'btn-secondary' %>">All</a>
            <a href="/admin/listings?status=available"
                class="btn btn-sm <%= statusFilter === 'available' ? 'btn-primary' : 'btn-secondary' %>">Available</a>
            <a href="/admin/listings?status=claimed"
                class="btn btn-sm <%= statusFilter === 'claimed' ? 'btn-primary' : 'btn-secondary' %>">Claimed</a>
            <a href="/admin/listings?status=completed"
                class="btn btn-sm <%= statusFilter === 'completed' ? 'btn-primary' : 'btn-secondary' %>">Completed</a>
            <a href="/admin/listings?status=expired"
                class="btn btn-sm <%= statusFilter === 'expired' ? 'btn-primary' : 'btn-secondary' %>">Expired</a>
        </div>

        <% if (listings.length===0) { %>
            <div class="empty-state">
                <p>No food listings found.</p>
            </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                <th>Donor</th>
                                <th>Quantity</th>
                                <th>Location</th>
                                <th>Expiry</th>
                                <th>Status</th>
                                <th>Posted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% listings.forEach(listing=> { %>
                                <tr>
                                    <td><strong>
                                            <%= listing.itemName %>
                                        </strong></td>
                                    <td>
                                        <%= listing.donor ? listing.donor.name : 'N/A' %>
                                    </td>
                                    <td>
                                        <%= listing.quantity %>
                                    </td>
                                    <td>
                                        <%= listing.pickupLocation %>
                                    </td>
                                    <td>
                                        <%= new Date(listing.expiryTime).toLocaleString() %>
                                    </td>
                                    <td>
                                        <span
                                            class="badge badge-<%= listing.status === 'available' ? 'success' : listing.status === 'claimed' ? 'warning' : listing.status === 'completed' ? 'info' : 'danger' %>">
                                            <%= listing.status.charAt(0).toUpperCase() + listing.status.slice(1) %>
                                        </span>
                                    </td>
                                    <td>
                                        <%= new Date(listing.createdAt).toLocaleDateString() %>
                                    </td>
                                    <td>
                                        <form action="/admin/remove-listing/<%= listing._id %>" method="POST"
                                            onsubmit="return confirm('Remove this listing?')">
                                            <button type="submit" class="btn btn-sm btn-danger">🗑️ Remove</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>

                    <div class="form-actions" style="margin-top: 1.5rem;">
                        <a href="/admin/dashboard" class="btn btn-secondary">← Back to Dashboard</a>
                    </div>
    </div>

    <%- include('../partials/footer') %>