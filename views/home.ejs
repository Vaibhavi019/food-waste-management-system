<%- include('partials/header') %>

<section class="hero hero-premium">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <span class="hero-kicker">SIH 26234 • AI-POWERED ECOSYSTEM</span>
        <h1 class="hero-title">
            <span class="hero-highlight">SANCHARI</span>
        </h1>
        <p class="hero-subtitle">
            Smart Food. Smarter Redistribution. AI-powered food waste reduction and sustainable redistribution ecosystem for Institutional Kitchens and Food Processing Units.
        </p>
        <div class="hero-cta-row">
            <% if (locals.currentUser && currentUser.role === 'donor') { %>
                <a href="/donor/dashboard" class="btn btn-hero">Command Center →</a>
            <% } else if (locals.currentUser && currentUser.role === 'receiver') { %>
                <a href="/receiver/dashboard" class="btn btn-hero">Command Center →</a>
            <% } else if (locals.currentUser && currentUser.role === 'admin') { %>
                <a href="/admin/dashboard" class="btn btn-hero">Command Center →</a>
            <% } else { %>
                <a href="/register" class="btn btn-hero">Get Started</a>
                <a href="/login" class="btn btn-hero-secondary">Explore Platform</a>
            <% } %>
        </div>
    </div>
</section>

<section class="cta-section">
    <h2 class="section-title">HOW SANCHARI WORKS</h2>
    <p class="section-subtitle">A unified lifecycle from kitchen to community.</p>

    <div class="architecture-strip" style="max-width: 1100px;">
        <span>Demand</span><b>→</b>
        <span>Surplus</span><b>→</b>
        <span>Quality</span><b>→</b>
        <span>Matching</span><b>→</b>
        <span>Logistics</span><b>→</b>
        <span>Utilization</span><b>→</b>
        <span>Traceability</span><b>→</b>
        <span>Impact</span>
    </div>
</section>

<section class="how-it-works">
    <h2 class="section-title">Ecosystem Modules</h2>
    <p class="section-subtitle">Predict surplus. Assess risk. Match recipients. Optimize redistribution. Track impact.</p>
    <div class="steps-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        <div class="step-card">
            <div class="stat-icon-big">🧠</div>
            <h3>Demand Forecasting</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> Determine optimal production limits using historical consumption data.</p>
        </div>
        <div class="step-card">
            <div class="stat-icon-big">🌡️</div>
            <h3>IoT Monitoring</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> Simulated real-time storage telemetry to protect food quality.</p>
        </div>
        <div class="step-card">
            <div class="stat-icon-big">📸</div>
            <h3>Quality-Risk Screening</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> AI-assisted visual anomaly detection (Human verification required).</p>
        </div>
        <div class="step-card">
            <div class="stat-icon-big">🎯</div>
            <h3>Recipient Matching</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> Algorithmic routing based on urgency, capacity, and distance.</p>
        </div>
        <div class="step-card">
            <div class="stat-icon-big">🚚</div>
            <h3>Smart Logistics</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> Estimated travel time and pickup feasibility calculation.</p>
        </div>
        <div class="step-card">
            <div class="stat-icon-big">♻️</div>
            <h3>Utilization Decision Support</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> Rule-based heuristics for redistribution, processing, and recovery.</p>
        </div>
        <div class="step-card">
            <div class="stat-icon-big">🔗</div>
            <h3>Digital Traceability</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> Tamper-evident hash-linked digital audit trail for verified handovers.</p>
        </div>
        <div class="step-card">
            <div class="stat-icon-big">📊</div>
            <h3>Sustainability Analytics</h3>
            <p><span class="badge badge-success" style="font-size:0.6rem;">IMPLEMENTED PROTOTYPE</span> Recorded diversion metrics with transparent impact indicator estimation.</p>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
