<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in - SANCHARI</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root {
      --login-bg: #F9FAFB;
      --login-surface: #ffffff;
      --login-border: #E5E7EB;
      --login-text: #111827;
      --login-text-muted: #6B7280;
      --login-primary: #059669;
      --login-primary-hover: #047857;
      --login-focus-ring: rgba(5, 150, 105, 0.2);
    }

    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: var(--login-bg);
      color: var(--login-text);
      min-height: 100vh;
      display: flex;
    }

    .login-container {
      display: flex;
      width: 100%;
      min-height: 100vh;
    }

    /* LEFT SIDE - Brand & Message */
    .login-left {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 45%;
      background: #F3F4F6;
      padding: 3rem;
      border-right: 1px solid var(--login-border);
      position: relative;
      overflow: hidden;
    }

    @media (min-width: 900px) {
      .login-left {
        display: flex;
      }
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--login-text);
      text-decoration: none;
      z-index: 10;
    }

    .brand-mark {
      background: var(--login-primary);
      color: #fff;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      font-weight: 800;
    }

    .brand-content {
      max-width: 480px;
      z-index: 10;
    }

    .brand-headline {
      font-size: 2.25rem;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 1.25rem;
      color: var(--login-text);
      letter-spacing: -0.02em;
    }

    .brand-subhead {
      font-size: 1.1rem;
      line-height: 1.6;
      color: var(--login-text-muted);
    }

    /* Abstract subtle shape */
    .abstract-shape {
      position: absolute;
      bottom: -10%;
      right: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(5,150,105,0.06) 0%, rgba(243,244,246,0) 70%);
      border-radius: 50%;
      z-index: 1;
      pointer-events: none;
    }

    /* RIGHT SIDE - Form */
    .login-right {
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1;
      padding: 2rem;
      align-items: center;
    }

    .form-wrapper {
      width: 100%;
      max-width: 400px;
      background: var(--login-surface);
      padding: 2.5rem;
      border-radius: 12px;
      border: 1px solid var(--login-border);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }

    @media (max-width: 899px) {
      .form-wrapper {
        box-shadow: none;
        border: none;
        background: transparent;
        padding: 1rem;
      }
      .mobile-logo {
        display: inline-flex;
        margin-bottom: 2rem;
      }
    }

    .mobile-logo {
      display: none;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--login-text);
      text-decoration: none;
    }

    @media (max-width: 899px) {
      .mobile-logo {
        display: inline-flex;
      }
    }

    .form-header {
      margin-bottom: 2rem;
    }

    .form-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--login-text);
      margin: 0 0 0.5rem 0;
      letter-spacing: -0.01em;
    }

    .form-subtitle {
      font-size: 0.95rem;
      color: var(--login-text-muted);
      margin: 0;
    }

    .input-group {
      margin-bottom: 1.25rem;
      position: relative;
    }

    .input-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      margin-bottom: 0.5rem;
    }

    .form-control {
      width: 100%;
      padding: 0.625rem 0.75rem;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      color: var(--login-text);
      background-color: #fff;
      border: 1px solid #D1D5DB;
      border-radius: 6px;
      box-sizing: border-box;
      transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--login-primary);
      box-shadow: 0 0 0 3px var(--login-focus-ring);
    }

    .form-control::placeholder {
      color: #9CA3AF;
    }

    .password-toggle {
      position: absolute;
      right: 0.75rem;
      top: 2.1rem;
      background: none;
      border: none;
      color: #9CA3AF;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      padding: 0;
    }

    .password-toggle:hover {
      color: #4B5563;
    }

    .options-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
    }

    .checkbox-wrapper {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .checkbox-wrapper input[type="checkbox"] {
      width: 1rem;
      height: 1rem;
      border: 1px solid #D1D5DB;
      border-radius: 4px;
      accent-color: var(--login-primary);
    }

    .checkbox-wrapper label {
      color: #374151;
      cursor: pointer;
    }

    .forgot-link {
      color: var(--login-primary);
      font-weight: 500;
      text-decoration: none;
    }

    .forgot-link:hover {
      text-decoration: underline;
    }

    .btn-submit {
      width: 100%;
      padding: 0.625rem 1rem;
      font-size: 0.95rem;
      font-weight: 500;
      font-family: 'Inter', sans-serif;
      color: #fff;
      background-color: var(--login-primary);
      border: 1px solid transparent;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.15s ease-in-out;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .btn-submit:hover {
      background-color: var(--login-primary-hover);
    }

    .form-footer {
      margin-top: 2rem;
      text-align: center;
      font-size: 0.875rem;
      color: var(--login-text-muted);
    }

    .form-footer a {
      color: var(--login-primary);
      font-weight: 500;
      text-decoration: none;
    }

    .form-footer a:hover {
      text-decoration: underline;
    }

    .alert {
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .alert-error {
      background-color: #FEF2F2;
      color: #991B1B;
      border: 1px solid #F87171;
    }

    .alert-success {
      background-color: #F0FDF4;
      color: #166534;
      border: 1px solid #4ADE80;
    }
  </style>
</head>
<body>

  <div class="login-container">

    <!-- LEFT SIDE: Brand & Value Proposition -->
    <div class="login-left">
      <a href="/" class="brand-logo">
        <span class="brand-mark">S</span>
        SANCHARI
      </a>

      <div class="brand-content">
        <h1 class="brand-headline">Give surplus food a second destination.</h1>
        <p class="brand-subhead">
          Connect surplus food with nearby community needs through verified pickup and redistribution. A reliable operations platform for institutional kitchens and NGOs.
        </p>
      </div>

      <div style="font-size: 0.85rem; color: #9CA3AF; z-index: 10;">
        &copy; <%= new Date().getFullYear() %> SANCHARI Operations
      </div>

      <div class="abstract-shape"></div>
    </div>

    <!-- RIGHT SIDE: Login Form -->
    <div class="login-right">

      <a href="/" class="mobile-logo">
        <span class="brand-mark">S</span>
        SANCHARI
      </a>

      <div class="form-wrapper">
        <div class="form-header">
          <h2 class="form-title">Welcome back</h2>
          <p class="form-subtitle">Sign in to your SANCHARI account.</p>
        </div>

        <% if (locals.error) { %>
          <div class="alert alert-error">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <%= error %>
          </div>
        <% } %>

        <% if (locals.success) { %>
          <div class="alert alert-success">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <%= success %>
          </div>
        <% } %>

        <form action="/login" method="POST">

          <div class="input-group">
            <label for="username" class="input-label">Username</label>
            <input
              type="text"
              id="username"
              name="username"
              class="form-control"
              placeholder="Enter your username"
              required
              autocomplete="username"
            >
          </div>

          <div class="input-group">
            <label for="password" class="input-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-control"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
            >
            <button type="button" class="password-toggle" onclick="togglePassword()" aria-label="Toggle password visibility">Show</button>
          </div>

          <div class="options-row">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="remember" name="remember">
              <label for="remember">Remember me</label>
            </div>
            <a href="#" class="forgot-link" onclick="alert('Password reset instructions sent to administrator.')">Forgot password?</a>
          </div>

          <button type="submit" class="btn-submit" id="submitBtn">
            Sign in
          </button>
        </form>

        <div class="form-footer">
          Don't have an account? <a href="/register">Create an account</a>
        </div>
      </div>

    </div>
  </div>

  <script>
    function togglePassword() {
      const passwordInput = document.getElementById('password');
      const toggleBtn = document.querySelector('.password-toggle');

      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        toggleBtn.textContent = 'Hide';
      } else {
        passwordInput.type = 'password';
        toggleBtn.textContent = 'Show';
      }
    }

    // Optional: Add simple loading state to button
    document.querySelector('form').addEventListener('submit', function() {
      const btn = document.getElementById('submitBtn');
      btn.style.opacity = '0.8';
      btn.style.pointerEvents = 'none';
      btn.innerHTML = '<svg style="animation: spin 1s linear infinite; margin-right: 8px;" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg> Signing in...';

      // Inline keyframes for the spinner just in case
      if(!document.getElementById('spin-style')) {
        const style = document.createElement('style');
        style.id = 'spin-style';
        style.innerHTML = '@keyframes spin { 100% { transform: rotate(360deg); } }';
        document.head.appendChild(style);
      }
    });
  </script>
</body>
</html>