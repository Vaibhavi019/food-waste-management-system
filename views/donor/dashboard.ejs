<%- include('../partials/header') %>

<div class="main-content" style="max-width: 1440px; margin: 0 auto; padding: 2rem;">
    <!-- HERO / COMMAND CENTER HEADER -->
    <header class="animate-fade-up hero-gradient" style="background: var(--surface); color: var(--text); padding: 3rem; border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-md); position: relative; overflow: hidden; border: 1px solid var(--border);">
        <div style="position: absolute; top: 0; right: 0; bottom: 0; width: 50%; background: radial-gradient(circle at center right, var(--hero-glow) 0%, transparent 60%);"></div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 2;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="font-weight: 700; color: var(--primary); font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase;">SANCHARI FOOD OPERATIONS CENTER</span>
                    <span style="background: rgba(43, 192, 131, 0.15); border: 1px solid rgba(43, 192, 131, 0.3); color: #2bc083; padding: 0.2rem 0.6rem; border-radius: 99px; font-size: 0.65rem; font-weight: 700; display: flex; align-items: center; gap: 0.4rem;">
                        <span class="animate-pulse-dot" style="display: inline-block; width: 6px; height: 6px; background: #2bc083; border-radius: 50%;"></span>
                        AI SYSTEM ONLINE
                    </span>
                </div>
                <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem;">Donor Dashboard</h1>
                <p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px;">Prevent surplus before it becomes waste.</p>
                <% if (locals.generatedAt) { %>
                    <p style="font-size: 0.75rem; color: #718096; margin-top: 1rem;">Last analysis: <%= new Date(locals.generatedAt).toLocaleTimeString() %></p>
                <% } else { %>
                    <p style="font-size: 0.75rem; color: #718096; margin-top: 1rem;">Last analysis: Just now</p>
                <% } %>
            </div>
            <div style="display: flex; gap: 1rem;">
                <a href="/donor/add-food" class="btn btn-primary card-hover" style="padding: 0.75rem 1.5rem; font-weight: 700;">＋ Record Surplus</a>
                <a href="/donor/intelligence" class="btn glass-panel card-hover" style="padding: 0.75rem 1.5rem; font-weight: 700; color: var(--text);">Deep Intelligence</a>
            </div>
        </div>
    </header>

    <!-- CORE METRICS STRIP -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2.5rem;">
        <div class="card card-hover animate-fade-up delay-100" style="padding: 1.5rem; border-top: 3px solid var(--border);">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Today's Surplus</div>
            <div style="font-size: 2.25rem; font-weight: 800; color: var(--text); line-height: 1;"><%= stats.totalSurplus %></div>
        </div>
        <div class="card card-hover animate-fade-up delay-200" style="padding: 1.5rem; border-top: 3px solid var(--info);">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Available Donations</div>
            <div style="font-size: 2.25rem; font-weight: 800; color: var(--info); line-height: 1;"><%= stats.activeListings %></div>
        </div>
        <div class="card card-hover animate-fade-up delay-300" style="padding: 1.5rem; border-top: 3px solid <%= stats.wasteRate > 15 ? 'var(--danger)' : 'var(--warning)' %>;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">At-Risk Food</div>
            <div style="font-size: 2.25rem; font-weight: 800; color: <%= stats.wasteRate > 15 ? 'var(--danger)' : 'var(--warning)' %>; line-height: 1;"><%= stats.wasteRate %>%</div>
        </div>
        <div class="card card-hover animate-fade-up delay-400" style="padding: 1.5rem; border-top: 3px solid var(--success);">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Completed Handovers</div>
            <div style="font-size: 2.25rem; font-weight: 800; color: var(--success); line-height: 1;"><%= stats.completedDonations %></div>
        </div>
    </div>

    <!-- MAIN GRID -->
    <div class="animate-fade-up delay-500" style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2rem;">
        
        <!-- LEFT COLUMN: OPERATIONS & REDISTRIBUTION -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            
            <!-- OTP WORKFLOW (PENDING HANDOVERS) -->
            <section>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px solid var(--border-light); padding-bottom: 0.5rem;">
                    <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text);">Pending Handovers</h2>
                    <% if (activeClaims && activeClaims.length > 0) { %>
                        <span class="badge badge-warning"><%= activeClaims.length %> Requires Verification</span>
                    <% } %>
                </div>

                <% if (!activeClaims || activeClaims.length === 0) { %>
                    <div style="background: var(--surface); padding: 3rem; border-radius: var(--radius-lg); text-align: center; border: 1px dashed var(--border);">
                        <p style="color: var(--text-muted);">No pending handovers require OTP verification.</p>
                    </div>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <% activeClaims.forEach(claim => { %>
                            <div class="card card-hover" style="border-left: 4px solid var(--warning); padding: 1.5rem; display: flex; justify-content: space-between; align-items: stretch; gap: 2rem;">
                                <div style="flex: 1;">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                                        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text);"><%= claim.food.itemName %></h3>
                                        <span class="badge badge-warning animate-pulse-glow">CLAIMED</span>
                                    </div>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.9rem;">
                                        <div>
                                            <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Receiver</div>
                                            <div style="font-weight: 600; color: var(--text);"><%= claim.receiver.name %> (<%= claim.receiver.organization || 'Community' %>)</div>
                                        </div>
                                        <div>
                                            <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Quantity</div>
                                            <div style="font-weight: 600; color: var(--text);"><%= claim.food.quantity %></div>
                                        </div>
                                        <div>
                                            <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Pickup Location</div>
                                            <div style="font-weight: 600; color: var(--text);"><%= claim.food.pickupLocation %></div>
                                        </div>
                                        <div>
                                            <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Claim ID</div>
                                            <div style="font-family: monospace; color: var(--text);"><%= String(claim._id).substring(0,8) %>...</div>
                                        </div>
                                    </div>
                                </div>
                                <div style="background: var(--surface-muted); padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border); display: flex; flex-direction: column; justify-content: center; min-width: 250px;">
                                    <div style="font-size: 0.85rem; font-weight: 700; color: var(--danger); text-align: center; text-transform: uppercase; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.25rem;">
                                        🔒 SECURE HANDOVER
                                    </div>
                                    <div style="font-size: 0.75rem; font-weight: 600; color: var(--text); text-align: center; text-transform: uppercase; margin-bottom: 1rem;">6-Digit Verification</div>
                                    <form action="/donor/verify-otp" method="POST" style="display: flex; flex-direction: column; gap: 0.75rem;">
                                        <input type="hidden" name="claimId" value="<%= claim._id %>">
                                        <input type="text" name="otp" placeholder="Enter OTP" maxlength="6" pattern="[0-9]{6}" required style="padding: 0.75rem; border: 2px solid var(--border); border-radius: var(--radius-sm); font-family: monospace; font-size: 1.25rem; letter-spacing: 4px; text-align: center; outline: none; transition: border-color 0.2s; background: var(--surface);">
                                        <button type="submit" class="btn btn-primary" style="padding: 0.75rem; font-weight: 700; background: var(--text); border-color: var(--text);">Verify & Complete</button>
                                    </form>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <!-- ACTIVE DONATIONS (REDISTRIBUTION OPERATIONS) -->
            <section>
                <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; color: var(--text); border-bottom: 2px solid var(--border-light); padding-bottom: 0.5rem;">Food Quality & Redistribution Tracker</h2>
                <% const activeDonations = listings.filter(l => l.status === 'available').slice(0, 5); %>
                <% if (activeDonations.length === 0) { %>
                    <div class="card" style="padding: 3rem; text-align: center; border: 1px dashed var(--border); background: var(--surface);">
                        <p style="color: var(--text-muted);">No available surplus registered at this time.</p>
                    </div>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <% activeDonations.forEach(item => { %>
                            <div class="card card-hover" style="padding: 1.25rem;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                                    <div>
                                        <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--text);"><%= item.itemName %></h3>
                                        <div style="font-size: 0.85rem; color: var(--text-muted);">Quantity: <%= item.surplusQuantity || item.quantity %> <%= item.unit || '' %></div>
                                    </div>
                                    <span class="badge badge-success">AVAILABLE</span>
                                </div>
                                
                                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; background: var(--surface-muted); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid var(--border-light);">
                                    <div>
                                        <div style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Quality Score</div>
                                        <div style="font-weight: 700; color: <%= item.qualityScore >= 80 ? 'var(--success)' : 'var(--warning)' %>; margin-bottom: 0.25rem;"><%= item.qualityScore %>/100</div>
                                        <div style="width: 100%; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden;">
                                            <div class="animate-progress" style="width: <%= item.qualityScore %>%; height: 100%; background: <%= item.qualityScore >= 80 ? 'var(--success)' : 'var(--warning)' %>;"></div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Visual Risk</div>
                                        <div style="font-weight: 600; color: <%= (item.visualRiskLevel || '').includes('HIGH') ? 'var(--danger)' : 'var(--text)' %>;"><%= item.visualRiskLevel || 'N/A' %></div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Storage</div>
                                        <div style="font-weight: 600; color: var(--text);"><%= item.storageTempC !== null ? item.storageTempC + '°C' : 'N/A' %> | <%= item.humidityPct !== null ? item.humidityPct + '%' : 'N/A' %></div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Verification</div>
                                        <div style="font-weight: 600; color: <%= item.humanVerificationRequired ? 'var(--warning)' : 'var(--success)' %>;"><%= item.humanVerificationRequired ? 'Required' : 'Automated' %></div>
                                    </div>
                                </div>

                                <% if (item.traceability && item.traceability.events.length > 0) { %>
                                    <details>
                                        <summary style="cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--primary);">View Traceability (<%= item.traceability.eventCount %> events)
                                        <% if (item.traceability.integrity && item.traceability.integrity.valid) { %>
                                            <span class="badge badge-success" style="margin-left: 0.5rem;">VERIFIED ✓</span>
                                        <% } %>
                                        </summary>
                                        <div style="margin-top: 1rem; padding-left: 1rem; border-left: 2px solid var(--border-light); font-size: 0.8rem; position: relative;">
                                            <% item.traceability.events.forEach(ev => { %>
                                                <div style="margin-bottom: 0.75rem; position: relative;">
                                                    <div style="position: absolute; left: -1.35rem; top: 0.25rem; width: 8px; height: 8px; border-radius: 50%; background: var(--primary);"></div>
                                                    <div style="font-weight: 600; color: var(--text);"><%= ev.eventLabel %></div>
                                                    <div style="color: var(--text-muted);">
                                                        <%= ev.timestamp ? new Date(ev.timestamp).toLocaleString() : 'Date unavailable' %> 
                                                        <% if (ev.eventHash) { %>
                                                            <span style="font-family: monospace; color: var(--success); margin-left: 0.5rem;">✓ <%= ev.eventHash.substring(0, 16) %>...</span>
                                                        <% } else { %>
                                                            <span style="font-style: italic; color: var(--text-muted); margin-left: 0.5rem;">Legacy Event</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </details>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>

        <!-- RIGHT COLUMN: INTELLIGENCE & IMPACT -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            
            <!-- AI PRODUCTION INTELLIGENCE -->
            <section>
                <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">AI Production Intelligence</h2>
                <div class="card card-hover" style="padding: 1.5rem; background: var(--surface); color: var(--text); border: 1px solid var(--border); box-shadow: var(--card-shadow);">
                    <% 
                        const safeAiData = locals.aiData || {};
                        const forecastObj = safeAiData.forecast || {};
                        const confidence = forecastObj.confidencePct || forecastObj.confidenceScore || 0;
                        const predictedDemand = forecastObj.predictedDemand || 0;
                        
                        const surplusObj = safeAiData.surplus || {};
                        const predictedSurplus = surplusObj.predictedSurplus || 0;
                        const riskLevel = surplusObj.riskLevel || 'LOW';
                        
                        const recObj = safeAiData.recommendation || {};
                        const recommendedProduction = recObj.recommendedProduction || 0;
                        
                        const expObj = safeAiData.explanation || {};
                        const rawFactors = Array.isArray(recObj.factors) ? recObj.factors : (Array.isArray(expObj.factors) ? expObj.factors : []);
                        
                        const maxChartVal = Math.max(predictedDemand, predictedSurplus, recommendedProduction, 1);
                        const pDemand = (predictedDemand / maxChartVal) * 100;
                        const pSurplus = (predictedSurplus / maxChartVal) * 100;
                        const pRec = (recommendedProduction / maxChartVal) * 100;
                    %>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">AI Demand vs Surplus Forecast</span>
                        <span style="background: var(--primary-soft); color: var(--success); padding: 0.25rem 0.75rem; border-radius: 99px; font-size: 0.75rem; font-weight: 700; border: 1px solid var(--border);">
                            <%= confidence %>% CONFIDENCE
                        </span>
                    </div>

                    <!-- AI GRAPHICAL VISUALIZATION -->
                    <div style="background: var(--surface-alt); padding: 1.5rem 1.5rem 2rem 1.5rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; border: 1px solid var(--border); position: relative; overflow-x: auto;">
                        <svg viewBox="0 0 500 220" style="width: 100%; min-width: 450px; height: auto; display: block; overflow: visible;">
                            <defs>
                                <linearGradient id="demandGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#63B3ED" stop-opacity="0.3"/>
                                    <stop offset="100%" stop-color="#63B3ED" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            
                            <!-- Grid Lines -->
                            <line x1="40" y1="20" x2="380" y2="20" stroke="var(--chart-grid)" stroke-dasharray="4" />
                            <line x1="40" y1="80" x2="380" y2="80" stroke="var(--chart-grid)" stroke-dasharray="4" />
                            <line x1="40" y1="140" x2="380" y2="140" stroke="var(--chart-grid)" stroke-dasharray="4" />
                            <line x1="40" y1="180" x2="380" y2="180" stroke="var(--border)" stroke-width="1" />
                            
                            <!-- Y Axis Labels (Portions) -->
                            <text x="35" y="25" fill="var(--text-muted)" font-size="10" text-anchor="end"><%= maxChartVal %></text>
                            <text x="35" y="105" fill="var(--text-muted)" font-size="10" text-anchor="end"><%= Math.round(maxChartVal/2) %></text>
                            <text x="35" y="185" fill="var(--text-muted)" font-size="10" text-anchor="end">0</text>
                            
                            <!-- X Axis Labels (Time) -->
                            <text x="40" y="200" fill="var(--text-muted)" font-size="10" text-anchor="middle">Now</text>
                            <text x="210" y="200" fill="var(--text-muted)" font-size="10" text-anchor="middle">+12h</text>
                            <text x="380" y="200" fill="var(--text-muted)" font-size="10" text-anchor="middle">24h Forecast</text>
                            
                            <!-- Today Marker -->
                            <line x1="40" y1="20" x2="40" y2="180" stroke="var(--border)" stroke-dasharray="2" />
                            <circle cx="40" cy="180" r="4" fill="var(--text-muted)" />

                            <% 
                                const calcY = (val) => 180 - ((val / maxChartVal) * 160); 
                                const dY = calcY(predictedDemand);
                                const sY = calcY(predictedSurplus);
                                const rY = calcY(recommendedProduction);
                            %>

                            <!-- Demand Path -->
                            <path d="M40 <%= dY %> C 125 <%= dY %>, 295 <%= dY %>, 380 <%= dY %>" fill="none" stroke="#63B3ED" stroke-width="3" style="stroke-dasharray: 400; stroke-dashoffset: 400; animation: drawLine 2s forwards;" />
                            <circle cx="380" cy="<%= dY %>" r="5" fill="#63B3ED" style="opacity: 0; animation: fadeIn 0.5s forwards 2s;" />
                            <text x="390" y="<%= dY + 4 %>" fill="#63B3ED" font-size="11" font-weight="bold" style="opacity: 0; animation: fadeIn 0.5s forwards 2s;">Demand (<%= predictedDemand %>)</text>

                            <!-- Surplus Path -->
                            <path d="M40 <%= sY %> C 125 <%= sY %>, 295 <%= sY %>, 380 <%= sY %>" fill="none" stroke="<%= riskLevel === 'HIGH' ? '#F56565' : '#48BB78' %>" stroke-width="3" style="stroke-dasharray: 400; stroke-dashoffset: 400; animation: drawLine 2s forwards 0.5s;" />
                            <circle cx="380" cy="<%= sY %>" r="5" fill="<%= riskLevel === 'HIGH' ? '#F56565' : '#48BB78' %>" style="opacity: 0; animation: fadeIn 0.5s forwards 2.5s;" />
                            <text x="390" y="<%= sY + 4 %>" fill="<%= riskLevel === 'HIGH' ? '#F56565' : '#48BB78' %>" font-size="11" font-weight="bold" style="opacity: 0; animation: fadeIn 0.5s forwards 2.5s;">Surplus (<%= predictedSurplus %>)</text>

                            <!-- Recommended Path -->
                            <path d="M40 <%= rY %> C 125 <%= rY %>, 295 <%= rY %>, 380 <%= rY %>" fill="none" stroke="#F6E05E" stroke-width="3" stroke-dasharray="6,4" style="stroke-dasharray: 400; stroke-dashoffset: 400; animation: drawLine 2s forwards 1s;" />
                            <circle cx="380" cy="<%= rY %>" r="5" fill="#F6E05E" style="opacity: 0; animation: fadeIn 0.5s forwards 3s;" />
                            <text x="390" y="<%= rY + 4 %>" fill="#F6E05E" font-size="11" font-weight="bold" style="opacity: 0; animation: fadeIn 0.5s forwards 3s;">Recommend (<%= recommendedProduction %>)</text>

                            <style>
                                @keyframes drawLine { to { stroke-dashoffset: 0; } }
                                @keyframes fadeIn { to { opacity: 1; } }
                            </style>
                        </svg>
                        <div style="font-size: 0.75rem; color: var(--text-muted); text-align: center; margin-top: 1rem; font-style: italic;">
                            AI forecast snapshot generated dynamically. Projecting potential outcomes over a 24-hour horizon.
                        </div>
                    </div>

                    <div style="background: var(--surface-muted); padding: 1rem; border-radius: 0.5rem; font-size: 0.85rem; border: 1px solid var(--border);">
                        <div style="font-weight: 700; margin-bottom: 0.5rem; color: var(--text);">Explainability Highlights:</div>
                        <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-secondary);">
                            <% if (rawFactors.length > 0) { %>
                                <% rawFactors.slice(0, 3).forEach(factor => { 
                                    const reason = typeof factor === 'string' ? factor : (factor.reason || 'Unknown factor');
                                    const impactSuffix = factor.impact ? ' (' + (factor.impact > 0 ? '+' : '') + factor.impact + '%)' : '';
                                %>
                                    <li style="margin-bottom: 0.25rem;"><%= reason %><%= impactSuffix %></li>
                                <% }) %>
                            <% } else { %>
                                <li style="margin-bottom: 0.25rem; font-style: italic; color: var(--text-muted); list-style: none; margin-left: -1.25rem;">No recommendation factors available yet.</li>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- SUSTAINABILITY IMPACT -->
            <section>
                <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Sustainability Ledger</h2>
                <div class="card card-hover" style="padding: 1.5rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1.5rem;">
                        <div>
                            <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Food Diverted</div>
                            <div style="font-size: 1.75rem; font-weight: 800; color: var(--text);"><%= (impact.foodDiverted || 0).toLocaleString() %> <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);"><%= impact.foodDivertedUnit || 'portions' %></span></div>
                        </div>
                        <div>
                            <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Actual Weight</div>
                            <div style="font-size: 1.75rem; font-weight: 800; color: var(--text);"><%= (impact.actualWeightKg || 0).toLocaleString() %> <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">kg</span></div>
                        </div>
                    </div>

                    <% if (!impact.estimatedImpact || (impact.estimatedImpact.co2eAvoidedKg === null && impact.estimatedImpact.waterAvoidedLiters === null)) { %>
                        <div style="background: var(--surface-muted); padding: 1rem; text-align: center; border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--text-muted); border: 1px dashed var(--border);">
                            Awaiting validated environmental data.
                        </div>
                    <% } else { %>
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            <% if (impact.estimatedImpact.co2eAvoidedKg !== null) { %>
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--surface-muted); border-radius: var(--radius-sm); border: 1px solid var(--border); position: relative; overflow: hidden;">
                                    <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--primary-dark);"></div>
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-left: 0.5rem;">Estimated CO₂e Impact</span>
                                    <strong style="font-size: 1.1rem; color: var(--primary-dark);">
                                        <%= impact.estimatedImpact.co2eAvoidedKg.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kg' %>
                                    </strong>
                                </div>
                            <% } %>
                            <% if (impact.estimatedImpact.waterAvoidedLiters !== null) { %>
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--surface-muted); border-radius: var(--radius-sm); border: 1px solid var(--border); position: relative; overflow: hidden;">
                                    <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--info);"></div>
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-left: 0.5rem;">Estimated Water Footprint</span>
                                    <strong style="font-size: 1.1rem; color: var(--info);">
                                        <%= impact.estimatedImpact.waterAvoidedLiters.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' L' %>
                                    </strong>
                                </div>
                            <% } %>
                            <div style="font-size: 0.75rem; color: var(--text-muted); text-align: center; margin-top: 0.5rem;">
                                Estimated using recorded food weight and configured food-specific factors.
                            </div>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- RECENT ACTIVITY -->
            <section>
                <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Recent Handovers</h2>
                <div class="card card-hover">
                    <% const completedDonationsList = listings.filter(l => l.status === 'completed').slice(0, 4); %>
                    <% if (completedDonationsList.length === 0) { %>
                        <div style="padding: 1.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">No completed handovers yet.</div>
                    <% } else { %>
                        <div style="display: flex; flex-direction: column;">
                            <% completedDonationsList.forEach((item, idx) => { %>
                                <div style="padding: 1rem; border-bottom: <%= idx === completedDonationsList.length - 1 ? 'none' : '1px solid var(--border-light)' %>; transition: background 0.2s;" onmouseover="this.style.background='var(--surface-muted)'" onmouseout="this.style.background='transparent'">
                                    <div style="font-weight: 600; font-size: 0.9rem; color: var(--text);"><%= item.itemName %></div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Completed on <%= item.updatedAt ? new Date(item.updatedAt).toLocaleDateString() : 'Date unavailable' %></div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
