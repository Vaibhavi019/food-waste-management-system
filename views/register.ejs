<%- include('partials/header') %>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1>Create Account</h1>
                <p>Join the intelligent food redistribution network</p>
            </div>
            <form action="/register" method="POST" class="auth-form">
                <div class="form-group">
                    <label for="role">I want to join as</label>
                    <select name="role" id="role" required onchange="toggleOrg()">
                        <option value="">— Select Role —</option>
                        <option value="donor">🏭 Institution / Kitchen</option>
                        <option value="receiver">🤝 NGO / Community Recipient</option>
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" name="name" id="name" placeholder="Enter your full name" required>
                    </div>
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" name="username" id="username" placeholder="Choose a username" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" name="email" id="email" placeholder="you@example.com" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" name="phone" id="phone" placeholder="Enter phone number" required>
                    </div>
                </div>

                <div class="form-group" id="orgGroup" style="display:none;">
                    <label for="organization">Organization Name</label>
                    <input type="text" name="organization" id="organization"
                        placeholder="Institution, NGO or community organization">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="latitude">Latitude <span class="text-muted">(optional)</span></label>
                        <input type="number" step="any" name="latitude" id="latitude" placeholder="17.3850">
                    </div>
                    <div class="form-group">
                        <label for="longitude">Longitude <span class="text-muted">(optional)</span></label>
                        <input type="number" step="any" name="longitude" id="longitude" placeholder="78.4867">
                    </div>
                </div>

                <div class="info-box compact">
                    <span class="info-icon">📍</span>
                    <p>Optional coordinates enable prototype route-distance and ETA optimization between the kitchen and recipient.</p>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="password" id="password" placeholder="Min. 6 characters"
                                required minlength="6">
                            <button type="button" class="password-toggle" onclick="togglePassword('password', this)"
                                aria-label="Toggle password visibility">
                                <svg viewBox="0 0 24 24">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="confirmPassword" id="confirmPassword"
                                placeholder="Re-enter password" required>
                            <button type="button" class="password-toggle"
                                onclick="togglePassword('confirmPassword', this)"
                                aria-label="Toggle password visibility">
                                <svg viewBox="0 0 24 24">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Create Account</button>
            </form>
            <div class="auth-footer">
                <p>Already have an account? <a href="/login">Log in</a></p>
            </div>
        </div>
    </div>

    <script>
        function toggleOrg() {
            const role = document.getElementById('role').value;
            document.getElementById('orgGroup').style.display = role === 'receiver' ? 'block' : 'none';
        }
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
            } else {
                input.type = 'password';
                btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
            }
        }
    </script>

    <%- include('partials/footer') %>