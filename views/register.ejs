<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - SANCHARI</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background: var(--bg); display: flex; flex-direction: column; min-height: 100vh;">

  <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: var(--space-xl) var(--space-md);">
    
    <div style="margin-bottom: var(--space-xl); text-align: center;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: var(--primary); color: #fff; border-radius: var(--radius-md); font-weight: 800; font-size: 1.5rem; margin-bottom: 1rem;">S</div>
      <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text); letter-spacing: 1px;">SANCHARI</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">Enterprise Food Intelligence & Redistribution</p>
    </div>

    <div class="card" style="width: 100%; max-width: 480px; box-shadow: var(--shadow-md);">
      <div class="card-body" style="padding: 2.5rem 2rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text); margin-bottom: 1.5rem; text-align: center;">Request Network Access</h2>

        <% if (locals.error) { %>
          <div class="alert alert-warning" style="padding: 0.75rem; margin-bottom: 1.5rem; font-size: 0.85rem;">
            <%= error %>
          </div>
        <% } %>

        <form action="/register" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
          
          <div class="form-group" style="margin: 0;">
            <label for="name" style="font-size: 0.85rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; display: block;">Full Name / Contact Person</label>
            <input type="text" id="name" name="name" required style="width: 100%;">
          </div>
          
          <div class="form-group" style="margin: 0;">
            <label for="organization" style="font-size: 0.85rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; display: block;">Organization Name <span style="font-weight: 400; color: var(--text-muted);">(Optional)</span></label>
            <input type="text" id="organization" name="organization" style="width: 100%;">
          </div>

          <div class="form-group" style="margin: 0;">
            <label for="email" style="font-size: 0.85rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; display: block;">Corporate Email address</label>
            <input type="email" id="email" name="email" required style="width: 100%;">
          </div>
          
          <div class="form-group" style="margin: 0;">
            <label for="password" style="font-size: 0.85rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; display: block;">Password</label>
            <input type="password" id="password" name="password" required minlength="6" style="width: 100%;">
          </div>

          <div class="form-group" style="margin: 0;">
            <label for="role" style="font-size: 0.85rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; display: block;">Network Role</label>
            <select name="role" id="role" required style="width: 100%; background: var(--surface);">
              <option value="donor">Food Donor (Producer/Kitchen)</option>
              <option value="receiver">Food Receiver (Community/NGO)</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; font-size: 1rem; margin-top: 0.5rem;">Submit Application</button>
        </form>

        <div style="margin-top: 2rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
          Already have an account? <a href="/login" style="color: var(--primary); font-weight: 600;">Sign In</a>
        </div>
        <div style="margin-top: 1rem; text-align: center;">
          <a href="/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">Return to Home</a>
        </div>
      </div>
    </div>
  </div>

</body>
</html>